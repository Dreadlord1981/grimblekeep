[resource]
script = ExtResource("1")
id = &"foundation"
definitions = Array[Resource]([SubResource("Imp"), SubResource("Treasury"), SubResource("Lair"), SubResource("Grubbin")])
feature_scripts = Array[Script]([ExtResource("5"), ExtResource("4")])
